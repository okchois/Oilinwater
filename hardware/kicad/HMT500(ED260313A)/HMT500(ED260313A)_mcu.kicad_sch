(text "Option bytes: nBOOT_SEL=1, nBOOT0=1, IWDG_SW=0, RDP 1" (at 33.02 188.722 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 09c1d2b4-3a36-5676-b84e-80bd817dc11d))
(text "  -> in-house RS-485 bootloader 0x08000000 (dec. #31)." (at 33.02 194.564 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 388055f5-8b6e-5982-a8fb-36b93f7ced34))
(text "VDDA = VDD (LQFP48); VREF+ tied to +3V3 (C20)." (at 33.02 200.406 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 99c16f6b-6e85-55ff-93ae-687c4c3f0b3c))
(text "PCB temp (mid): internal sensor, ADC ch TS + TS_CAL." (at 33.02 206.248 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 065cf307-35e6-5727-a0df-9c32ae0cf0c5))
