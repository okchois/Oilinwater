(text "Same die as DP2000 (G0B1CCT6); T3 = -40..125 C." (at 33.02 217.932 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid c2534c7f-2214-5100-850c-573682cb1a66))
