(text "BOOT0 shares PA14/SWCLK - no pull-down." (at 33.02 182.88 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 3d2df85f-d585-554a-93f8-1ef062b7b633))
(text "Option bytes: nBOOT_SEL=1, nBOOT0=1" (at 33.02 188.722 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid bf9a1af1-5dc5-56df-8ed1-47dd7ff67587))
(text "  -> boot from flash (RS-485 bootloader 0x08000000)." (at 33.02 194.564 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid c7b6863b-93e8-5627-92ec-579e06203a89))
(text "VDDA = VDD (LQFP48); VREF+ tied to +3V3 (C20)." (at 33.02 200.406 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ea4c82e8-ad65-5ace-a457-0c6469082514))
(text "PCB temp (mid): internal sensor, ADC ch TS + TS_CAL." (at 33.02 206.248 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid f7c3c4a4-ee49-5efd-b2a6-f40bdaf89196))
(text "Cortex-M0+: no SWO (J2 pin 6 NC)." (at 33.02 212.09 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid e4a970cd-f923-53a0-a6a7-cc03a02f02ab))
(text "Same die as DP2000 (G0B1CCT6); T3 = -40..125 C." (at 33.02 217.932 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid df47b17f-6138-5162-af42-b880588fede5))
